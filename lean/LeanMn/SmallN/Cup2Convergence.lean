/-
  SmallN/Cup2Convergence.lean — CUP-2 convergence for n = 4..10

  Auto-generated by gen_cup2_ranks.py
  Proves convergence of the CUP-2 system at each specific n
  via a computational rank function that strictly decreases on bad steps.
  For n >= 10 (>=12K configs), rank table is split into chunks to avoid
  Lean elaborator stack-overflow on huge List literals.
-/
import LeanMn.Cycle

set_option maxRecDepth 65536

namespace LeanMn

-- Mixed-radix config encoding (big-endian): code = ((c[0]*m[1]+c[1])*m[2]+c[2])*...
private def configCode (rs : RingSpec) (c : Config rs) : Nat :=
  (List.finRange rs.n).foldl (fun acc i => acc * rs.m i + (c i).val) 0

/-! ### CUP-2 convergence at n = 4, product = 36, max rank = 5 -/

private abbrev cup2Spec4 := cup2Spec 4 (by omega)
private abbrev cup2Sys4 := cup2System 4 (by omega)
private abbrev cup2GC4 := cup2GoodCycle 4 (by omega)

private def cup2BadRankVals4 : List Nat :=
  [0, 0, 4, 0, 4, 0, 1, 2, 0, 1, 5, 0, 0, 1, 1, 0, 5, 0, 0, 1,
   3, 2, 3, 2, 0, 0, 0, 0, 1, 0, 0, 2, 2, 1, 0, 0]

private def cup2BadRank4 (c : Config cup2Spec4) : Nat :=
  cup2BadRankVals4.getD (configCode cup2Spec4 c) 0

private theorem cup2BadRank4_decreases_from
    (c : Config cup2Spec4)
    (hbad : c ∉ cup2GC4.configs)
    (i : Fin 4)
    (hpriv : privileged cup2Sys4 c i)
    (hnext : move cup2Sys4 c i ∉ cup2GC4.configs) :
    cup2BadRank4 (move cup2Sys4 c i) < cup2BadRank4 c := by
  native_decide +revert

private theorem cup2BadRank4_decreases :
    ∀ {c' c : Config cup2Spec4},
      badStep cup2Sys4 cup2GC4 c' c →
        cup2BadRank4 c' < cup2BadRank4 c := by
  intro c' c hstep
  rcases hstep with ⟨hbad, hnext, ⟨i, hpriv, rfl⟩⟩
  exact cup2BadRank4_decreases_from c hbad i hpriv hnext

theorem cup2Converges4 : converges cup2Sys4 cup2GC4 := by
  let f := cup2BadRank4
  let r : Config cup2Spec4 → Config cup2Spec4 → Prop := InvImage Nat.lt f
  have hwf : WellFounded r := by
    simpa [r] using (InvImage.wf f Nat.lt_wfRel.wf)
  refine Subrelation.wf (r := r) ?_ hwf
  intro c' c hstep
  exact cup2BadRank4_decreases hstep

